# ── Required — Gainsight Community API ───────────────────────────────────────
# Find these at: Community Control Panel → Integrations → API
INSIDED_CLIENT_ID=your-client-id-here
INSIDED_CLIENT_SECRET=your-client-secret-here

# Your community's API region endpoint
INSIDED_REGION=https://api2-us-west-2.insided.com

# Numeric user ID — the account articles are posted under
# Find it in Control Panel → Users → click your account → check the URL
INSIDED_AUTHOR_ID=12345

# ── Optional — AI article generation ─────────────────────────────────────────
# Use ONE of the following. Anthropic takes priority if both are set.

# Google Gemini — get free key at aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...

# Anthropic Claude — get key at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Without either key, AI generation is disabled; translation still works (free via Google Translate)
